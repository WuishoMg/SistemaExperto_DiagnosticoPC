{
  "version": 1,
  "reglas": [
    {
      "id": "r_alimentacion_led",
      "condiciones": [{"hecho": "s_no_enciende", "estado": "verdadero"}, {"hecho": "s_led_encendido", "estado": "falso"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_ruta_alimentacion"},
      "explicacion": "El equipo no inicia y el indicador de alimentación permanece apagado; procede revisar la ruta de alimentación."
    },
    {
      "id": "r_alimentacion_ventiladores",
      "condiciones": [{"hecho": "s_no_enciende", "estado": "verdadero"}, {"hecho": "s_ventiladores_giran", "estado": "falso"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_ruta_alimentacion"},
      "explicacion": "La ausencia de inicio y de movimiento de ventiladores orienta a comprobar alimentación, sin descartar placa o botón."
    },
    {
      "id": "r_ram_codigo_post",
      "condiciones": [{"hecho": "s_pitidos_ram_post", "estado": "verdadero"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_memoria_ram"},
      "explicacion": "Un código POST confirmado como error de memoria es evidencia directa para revisar la RAM."
    },
    {
      "id": "r_ram_prueba",
      "condiciones": [{"hecho": "s_error_prueba_ram", "estado": "verdadero"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_memoria_ram"},
      "explicacion": "Los errores reproducibles de una prueba de memoria justifican revisar módulo, conexión y controlador de memoria."
    },
    {
      "id": "r_ram_reinicio_post",
      "condiciones": [{"hecho": "s_reinicios_post", "estado": "verdadero"}, {"hecho": "s_pitidos_ram_post", "estado": "verdadero"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_memoria_ram"},
      "explicacion": "Los reinicios durante POST junto con un código de memoria orientan la revisión de RAM y conexiones."
    },
    {
      "id": "r_pantalla_externa",
      "condiciones": [{"hecho": "s_sin_imagen", "estado": "verdadero"}, {"hecho": "s_monitor_externo_funciona", "estado": "verdadero"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_pantalla_principal"},
      "explicacion": "Hay salida de video en otro monitor, por lo que se debe revisar la pantalla principal y su trayecto de señal."
    },
    {
      "id": "r_video_artefactos",
      "condiciones": [{"hecho": "s_artefactos_video", "estado": "verdadero"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_subsistema_video"},
      "explicacion": "Los artefactos persistentes requieren aislar monitor, cable, controlador y hardware gráfico."
    },
    {
      "id": "r_video_artefactos_error",
      "condiciones": [{"hecho": "s_artefactos_video", "estado": "verdadero"}, {"hecho": "s_pantalla_azul", "estado": "verdadero"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_subsistema_video"},
      "explicacion": "Artefactos y errores críticos simultáneos refuerzan la necesidad de revisar el subsistema de video, sin confirmar la GPU."
    },
    {
      "id": "r_video_sin_salida",
      "condiciones": [{"hecho": "s_sin_imagen", "estado": "verdadero"}, {"hecho": "s_monitor_externo_funciona", "estado": "falso"}, {"hecho": "s_led_encendido", "estado": "verdadero"}, {"hecho": "s_ventiladores_giran", "estado": "verdadero"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_subsistema_video"},
      "explicacion": "Con señales de energía pero sin imagen en dos pantallas, el trayecto de video es una posibilidad que requiere más pruebas."
    },
    {
      "id": "r_almacenamiento_firmware",
      "condiciones": [{"hecho": "s_unidad_no_detectada", "estado": "verdadero"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_deteccion_almacenamiento"},
      "explicacion": "La unidad ausente en BIOS/UEFI exige revisar detección, conexión y estado de la unidad."
    },
    {
      "id": "r_almacenamiento_sin_arranque",
      "condiciones": [{"hecho": "s_unidad_no_detectada", "estado": "verdadero"}, {"hecho": "s_sin_dispositivo_arranque", "estado": "verdadero"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_deteccion_almacenamiento"},
      "explicacion": "La ausencia de la unidad en firmware y del dispositivo de arranque respalda una falla de detección."
    },
    {
      "id": "r_almacenamiento_errores_io",
      "condiciones": [{"hecho": "s_errores_entrada_salida", "estado": "verdadero"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_salud_almacenamiento"},
      "explicacion": "Errores registrados de lectura o escritura justifican proteger datos y examinar unidad y conexión."
    },
    {
      "id": "r_almacenamiento_errores_arranque",
      "condiciones": [{"hecho": "s_errores_entrada_salida", "estado": "verdadero"}, {"hecho": "s_so_no_inicia", "estado": "verdadero"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_salud_almacenamiento"},
      "explicacion": "Los errores de entrada/salida junto con un arranque fallido hacen prioritaria la revisión de datos y almacenamiento."
    },
    {
      "id": "r_temperatura_medida",
      "condiciones": [{"hecho": "s_temperatura_alta", "estado": "verdadero"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_sobrecalentamiento"},
      "explicacion": "Una medición térmica anormal es evidencia del sobrecalentamiento observado."
    },
    {
      "id": "r_temperatura_apagado",
      "condiciones": [{"hecho": "s_temperatura_alta", "estado": "verdadero"}, {"hecho": "s_apagado_bajo_carga", "estado": "verdadero"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_sobrecalentamiento"},
      "explicacion": "La temperatura anormal junto con apagados bajo carga hace razonable investigar la protección térmica."
    },
    {
      "id": "r_temperatura_ventilador",
      "condiciones": [{"hecho": "s_temperatura_alta", "estado": "verdadero"}, {"hecho": "s_ventilador_ruidoso", "estado": "verdadero"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_sobrecalentamiento"},
      "explicacion": "La temperatura anormal acompañada de ventilación ruidosa orienta a revisar la refrigeración."
    },
    {
      "id": "r_so_no_inicia_unidad_presente",
      "condiciones": [{"hecho": "s_so_no_inicia", "estado": "verdadero"}, {"hecho": "s_unidad_no_detectada", "estado": "falso"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_arranque_so"},
      "explicacion": "Si el sistema no inicia pero la unidad sí aparece en firmware, se debe revisar configuración y archivos de arranque."
    },
    {
      "id": "r_so_mensaje_unidad_presente",
      "condiciones": [{"hecho": "s_sin_dispositivo_arranque", "estado": "verdadero"}, {"hecho": "s_unidad_no_detectada", "estado": "falso"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_arranque_so"},
      "explicacion": "El firmware detecta la unidad pero no un arranque válido; conviene revisar orden, modo y archivos de inicio."
    },
    {
      "id": "r_so_error_critico",
      "condiciones": [{"hecho": "s_pantalla_azul", "estado": "verdadero"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_error_critico_so"},
      "explicacion": "Un error crítico observado exige registrar su código y buscar la causa sin atribuirla todavía al sistema operativo."
    },
    {
      "id": "r_wifi_sin_red",
      "condiciones": [{"hecho": "s_sin_red", "estado": "verdadero"}, {"hecho": "s_wifi_deshabilitado", "estado": "verdadero"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_wifi_inhabilitado"},
      "explicacion": "La falta de red coincide con un adaptador Wi-Fi deshabilitado; habilitarlo es una primera prueba verificable."
    },
    {
      "id": "r_wifi_otros_conectan",
      "condiciones": [{"hecho": "s_sin_red", "estado": "verdadero"}, {"hecho": "s_wifi_deshabilitado", "estado": "verdadero"}, {"hecho": "s_otros_equipos_conectan", "estado": "verdadero"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_wifi_inhabilitado"},
      "explicacion": "Otros dispositivos funcionan y este equipo tiene Wi-Fi deshabilitado; la configuración local merece revisión."
    },
    {
      "id": "r_red_otros_conectan",
      "condiciones": [{"hecho": "s_sin_red", "estado": "verdadero"}, {"hecho": "s_otros_equipos_conectan", "estado": "verdadero"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_conectividad_local"},
      "explicacion": "Otros equipos usan la red mientras este no; el problema parece localizado en este equipo o su enlace."
    },
    {
      "id": "r_red_wifi_habilitado",
      "condiciones": [{"hecho": "s_sin_red", "estado": "verdadero"}, {"hecho": "s_otros_equipos_conectan", "estado": "verdadero"}, {"hecho": "s_wifi_deshabilitado", "estado": "falso"}],
      "conclusion": {"tipo": "diagnostico", "id": "d_conectividad_local"},
      "explicacion": "La red funciona en otros equipos y Wi-Fi no está deshabilitado aquí; procede revisar enlace y configuración local."
    }
  ]
}
